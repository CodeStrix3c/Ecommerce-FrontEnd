RewriteEngine On
RewriteBase /

# If file or folder exists, load it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise route everything to index.html
RewriteRule ^ index.html [L]
